# Case Breaker — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Supabase — get these from your project's API settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT — must match the JWT secret in your Supabase project settings
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-char-secret

# Cloudflare R2 — get from R2 → Manage R2 API tokens
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=case-breaker-products

# CORS — comma-separated list of allowed origins
# Development: http://localhost:5173 (Vite default)
# Production: https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:5173
