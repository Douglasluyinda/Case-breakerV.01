# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match your Supabase project's JWT secret
# Project Settings → API → JWT Settings → JWT Secret
JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# R2 → Manage API Tokens → Create Token (Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=case-breaker-files

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard → Developers → Webhooks → Add endpoint → reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products → Pro subscription price ID
STRIPE_PRO_PRICE_ID=price_...

# ── Flutterwave ───────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys
FLW_PUBLIC_KEY=FLWPUBK-...
FLW_SECRET_KEY=FLWSECK-...
# Dashboard → Webhooks → set a random secret string here and in FLW dashboard
FLW_WEBHOOK_HASH=your-random-webhook-secret

# ── URLs ──────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
APP_URL=https://case-breaker.vercel.app
# Comma-separated allowed CORS origins
CORS_ORIGINS=https://case-breaker.vercel.app
